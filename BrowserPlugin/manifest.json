{
  "manifest_version": 3,
  "name": "InterestLens Sidebar",
  "version": "0.1.0",
  "description": "Shows a side panel with links from a local scraper.",
  "permissions": ["scripting", "tabs"],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:8000/*",
    "http://localhost:8001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js", "sidebar.js"],
      "css": ["sidebar.css"],
      "run_at": "document_idle"
    }
  ]
}
