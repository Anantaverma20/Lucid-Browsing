# =============================================================================
# InterestLens – Environment variables
# Copy to .env and fill in your values. Do not commit .env.
# =============================================================================
# Scraper API = port 8000. Backend (agents + scrape) = port 8001.
# Run backend: uvicorn backend.main:app --host 127.0.0.1 --port 8001

# -----------------------------------------------------------------------------
# Scraping (POST/GET /scrape, sidebar article links)
# -----------------------------------------------------------------------------
BROWSERBASE_API_KEY=your_browserbase_api_key
BROWSERBASE_PROJECT_ID=your_browserbase_project_id

# Optional: LLM-based ad removal when scraping
OPENAI_API_KEY=your_openai_api_key

# Optional: Redis cache for scrape results (omit to disable caching)
# Option A – Redis Cloud / single URL
REDIS_URL=redis://default:password@host:port
# Option B – Local Redis (only if REDIS_URL is not set)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# -----------------------------------------------------------------------------
# Automation agent (POST /automate – self-evolving browser automation)
# Use a Gemini API key from https://aistudio.google.com/apikey (not OAuth).
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=your_gemini_api_key_from_ai_studio
# Force AI Studio; set to 0 when using GOOGLE_API_KEY from AI Studio
GOOGLE_GENAI_USE_VERTEXAI=0
ADK_MODEL=gemini-2.0-flash
# Self-evolving loop: on validation/execution failure, Checker sets last_error and the loop retries;
# Writer receives last_error and must fix the script. Set to at least 2–5 so the agent can learn from errors.
AUTOMATION_MAX_ITERATIONS=5
SANDBOX_TIMEOUT_SECONDS=60

# Daytona sandbox (parse-only syntax validation of generated JS)
DAYTONA_API_KEY=your_daytona_api_key
DAYTONA_SANDBOX_LANGUAGE=node
# Optional: override Daytona server / target
# DAYTONA_API_URL=
# DAYTONA_TARGET=

# Headless browser (execution validation on real page; requires: playwright install chromium)
HEADLESS_BROWSER_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# Composio (optional "Bridge": Gmail, Notion, Calendar, Linear/Jira, etc.)
# Set COMPOSIO_API_KEY to enable. Get key from https://app.composio.dev
# Connect apps (e.g. Gmail) in Composio dashboard, then set COMPOSIO_ENTITY_ID
# to the user_id shown on that connection so the backend uses the right account.
# -----------------------------------------------------------------------------
# COMPOSIO_API_KEY=your_composio_api_key
# COMPOSIO_ENTITY_ID=your_composio_connection_user_id
